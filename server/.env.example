NODE_ENV=development
PORT=5000

# Origin(s) allowed to call the API, comma separated (the deployed frontend URL in production)
CLIENT_ORIGIN=http://localhost:5173

# Supabase (server only: the service-role key must NEVER reach the browser)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Auth
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_PASSWORD=change-me

# Used to derive per-team gate slugs: HMAC(GATE_SECRET, teamId + previousFlag)
GATE_SECRET=change-me-too
