# Single env file for the whole project. Copy to .env at the repo root.
# Server reads everything; Vite exposes ONLY VITE_* vars to the browser.

# ---------- Server ----------
NODE_ENV=development
PORT=5000

# Origin(s) allowed to call the API, comma separated (the deployed frontend URL in production)
CLIENT_ORIGIN=http://localhost:5173

# Supabase (server only: the service-role key must NEVER reach the browser)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Auth
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_PASSWORD=change-me

# Used to derive per-team gate slugs: HMAC(GATE_SECRET, teamId + previousFlag)
GATE_SECRET=change-me-too

# ---------- Client (Vite) ----------
# Leave empty in dev (Vite proxy handles /api).
# In production set to the deployed server URL, e.g. https://sat-ctf-api.onrender.com
VITE_API_URL=

# false: use the real server + Supabase (log in with team1 / 1234 after npm run db:seed).
# true: the UI runs on src/data/mock.js and makes no game API calls (any Team ID + password).
VITE_USE_MOCKS=false
